#!/bin/bash
#SBATCH --job-name=florence2-gaps
#SBATCH --partition=frida
#SBATCH --time=12:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --output=/shared/home/juan.osorio/output/florence2_gaps_%j.out

# Fill in the Florence-2 snow masks that are missing for the annotated frames.
#
# Why a separate runner: snow_teachers.py walks whole camera directories, so
# `snow_teachers.py florence2 --cameras X` processes every frame of X (days per
# camera at ~40s/frame). tools/fill_florence2_gaps.py loads the model once and
# runs only the annotated frames that have no mask yet, writing the layout the
# pipeline reads (preprocessing/segmentation/florence2_snow_output, which
# workspace/segmentation/snow/florence2 points at).
#
# It runs the RELEASE copy of snow_teachers.py, not the cluster's: the release
# carries the two shims that newer transformers needs for Florence-2's
# trust_remote_code model (attn_implementation="eager", use_cache=False).
#
# Usage:
#   sbatch run_florence2_gaps.sbatch
#   MODEL_SIZE=base sbatch run_florence2_gaps.sbatch
#   LIMIT=20 sbatch run_florence2_gaps.sbatch          # gauge the rate first

MASTER_DIR="${MASTER_DIR:-/shared/home/juan.osorio/master}"
RELEASE_DIR="${RELEASE_DIR:-${MASTER_DIR}/release_check}"
DATA_DIR="${DATA_DIR:-${MASTER_DIR}/data}"
# Frames are spread across more than one tree: data/<camera>/ holds the earlier
# captures, night_images/<camera>/ the later ones the annotations also refer to.
# A single root is why an earlier run skipped every frame.
DATA_DIRS="${DATA_DIRS:-${DATA_DIR} ${MASTER_DIR}/night_images}"
OUT_DIR="${OUT_DIR:-${MASTER_DIR}/preprocessing/segmentation/florence2_snow_output}"
MODEL_SIZE="${MODEL_SIZE:-base}"
DEVICE="${DEVICE:-cuda}"
LIMIT="${LIMIT:-0}"
SCRIPT="${SCRIPT:-${MASTER_DIR}/tools/fill_florence2_gaps.py}"
# Explicit frame list, generated by the release checkout
# (tools/fill_florence2_gaps.py --dry-run, or fusion_cnn.load_gt_stems on a
# machine that has the model packages). Passing it avoids importing
# student_ground/student_snow on a box that only has segmentation/ pushed.
FRAMES_FILE="${FRAMES_FILE:-${MASTER_DIR}/tools/florence2_frames_to_fill.txt}"
# transformers overlay: the image may predate the <5.0 bound in
# requirements.txt and ship 5.x, which cannot load Florence-2 at all (see the
# note in the Dockerfile). Installing 4.57.6 into a private --target dir and
# putting that dir first on PYTHONPATH shadows the image's copy for this job
# only, leaving the image untouched. Verified: the release loader loads
# Florence-2 and produces a mask with this overlay in front.
TF_VERSION="${TF_VERSION:-4.57.6}"
TF_OVERLAY="${TF_OVERLAY:-${MASTER_DIR}/tf457}"

HF_TOKEN_FILE="/shared/home/juan.osorio/.hf_token"
HF_TOKEN=""
[ -f "${HF_TOKEN_FILE}" ] && HF_TOKEN=$(cat "${HF_TOKEN_FILE}" | tr -d '[:space:]')

CONTAINER="${SNOW_CONTAINER_IMAGE:-/shared/workspace/lkm/juan.osorio/container/snow_detector_env.sqfs}"
if [ ! -f "${CONTAINER}" ]; then
    echo "ERROR: Container image not found at ${CONTAINER}"
    exit 1
fi
[ -f "${SCRIPT}" ] || { echo "ERROR: ${SCRIPT} missing - push tools/fill_florence2_gaps.py first"; exit 1; }
[ -f "${FRAMES_FILE}" ] || { echo "ERROR: ${FRAMES_FILE} missing - push florence2_frames_to_fill.txt first"; exit 1; }
[ -f "${RELEASE_DIR}/segmentation/snow_teachers.py" ] || { echo "ERROR: ${RELEASE_DIR}/segmentation/snow_teachers.py missing - push it first"; exit 1; }

LIMIT_FLAG=""
[ "${LIMIT}" -gt 0 ] 2>/dev/null && LIMIT_FLAG="--limit ${LIMIT}"

# One --data-dir per root, in order.
DATA_DIR_FLAGS=""
for d in ${DATA_DIRS}; do
    DATA_DIR_FLAGS="${DATA_DIR_FLAGS} --data-dir ${d}"
done

mkdir -p "/shared/home/juan.osorio/output" "${OUT_DIR}"

echo "============================================================"
echo "FLORENCE-2 GAP FILL (FRIDA)"
echo "============================================================"
echo "  Job ID:       ${SLURM_JOB_ID}"
echo "  Node:         $(hostname)"
echo "  Model:        Florence-2-${MODEL_SIZE}"
echo "  Data dir:     ${DATA_DIR}"
echo "  Output dir:   ${OUT_DIR}"
echo "  Release code: ${RELEASE_DIR}"
echo "  Limit:        ${LIMIT:-0} (0=all missing)"
echo "  Container:    ${CONTAINER}"
echo "============================================================"
echo ""

srun \
  --container-image=${CONTAINER} \
  --container-mounts=/shared:/shared \
  --container-workdir=${MASTER_DIR} \
  bash -c "
    set -e
    export HF_TOKEN='${HF_TOKEN}'
    if [ ! -d '${TF_OVERLAY}/transformers' ]; then
      echo '== installing transformers ${TF_VERSION} overlay (one time) =='
      echo \"  python: \$(command -v python3) \$(python3 --version 2>&1)\"
      echo \"  uv on PATH: \$(command -v uv || echo none)   pip module: \$(python3 -m pip --version 2>&1 | head -1)\"
      if command -v uv >/dev/null 2>&1; then
        uv pip install --no-cache --system --target '${TF_OVERLAY}' 'transformers==${TF_VERSION}'
      elif [ -x /usr/local/bin/uv ]; then
        /usr/local/bin/uv pip install --no-cache --system --target '${TF_OVERLAY}' 'transformers==${TF_VERSION}'
      elif [ -x /root/.local/bin/uv ]; then
        /root/.local/bin/uv pip install --no-cache --system --target '${TF_OVERLAY}' 'transformers==${TF_VERSION}'
      elif python3 -m pip --version >/dev/null 2>&1; then
        python3 -m pip install --no-cache-dir --break-system-packages --target '${TF_OVERLAY}' 'transformers==${TF_VERSION}'
      else
        echo 'FATAL: neither uv nor pip found in this container - cannot build the overlay'
        exit 1
      fi
      ls -d '${TF_OVERLAY}/transformers' >/dev/null || { echo 'FATAL: overlay install produced no transformers/ directory'; exit 1; }
    fi
    export PYTHONPATH='${TF_OVERLAY}:${RELEASE_DIR}'
    python -c \"import transformers; print('transformers in use:', transformers.__version__)\"
    echo \"Started at \$(date)\"
    nvidia-smi
    echo ''

    python -u '${SCRIPT}' \
        --release-dir '${RELEASE_DIR}' \
        --frames-file '${FRAMES_FILE}' \
        ${DATA_DIR_FLAGS} \
        --out-dir '${OUT_DIR}' \
        --model-size '${MODEL_SIZE}' \
        --device '${DEVICE}' \
        ${LIMIT_FLAG}

    echo ''
    echo \"Finished at \$(date)\"
  "

echo ""
echo "Job finished!"
